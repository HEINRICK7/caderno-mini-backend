HOST=0.0.0.0
PORT=3000
API_PORT=3000
LOG_LEVEL=info
DATABASE_FILE=./data/caderno-mini.sqlite
# MinIO S3 API (host only, without scheme); use TLS in production; bucket must already exist.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=caderno-local
MINIO_SECRET_KEY=local-development-minio-secret
MINIO_BUCKET=caderno-assets
# Only trust the private Docker bridge when Nginx is the only service reaching the API.
TRUST_PROXY=127.0.0.1,172.16.0.0/12
AUTH_PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
PUBLIC_APP_URL=https://app.example.com
# Configure these before enabling passwordless sign-in in a shared environment.
SMTP_URL=
EMAIL_FROM=
# AbacatePay webhooks work with API key and webhook secret. Set both product IDs to enable checkout.
# Generate ABACATEPAY_WEBHOOK_SECRET with `openssl rand -hex 32`; never commit a real value.
# The API key needs CHECKOUT:CREATE; keep the key and webhook secret on the backend only.
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# Public fixed key documented by AbacatePay for verifying X-Webhook-Signature.
ABACATEPAY_WEBHOOK_SIGNATURE_KEY=
ABACATEPAY_PRODUCT_ANNUAL_ID=
ABACATEPAY_PRODUCT_LIFETIME_ID=
# Optional legacy Cakto webhook settings: keep these only while old Cakto events may arrive.
CAKTO_CHECKOUT_ANNUAL_URL=
CAKTO_PRODUCT_ANNUAL_ID=
CAKTO_WEBHOOK_SECRET_ANNUAL=
CAKTO_CHECKOUT_LIFETIME_URL=
CAKTO_PRODUCT_LIFETIME_ID=
CAKTO_WEBHOOK_SECRET_LIFETIME=
TEMPLATE_CATALOG_FILE=./catalog/templates.json
ANALYTICS_READ_TOKEN=
# Admin login is separate from customer magic-link authentication.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
