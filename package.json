{
  "name": "caderno-mini-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do Cadernô Express",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import=tsx --watch apps/api/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run apps/api/tests/unit",
    "test:integration": "vitest run apps/api/tests/integration",
    "test:e2e": "vitest run apps/api/tests/e2e",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/migrate-cli.js",
    "db:seed:dev": "node --env-file-if-exists=.env --import=tsx apps/api/src/infrastructure/database/seed-dev.ts",
    "db:backup": "node --env-file-if-exists=.env dist/backup-cli.js",
    "db:backup:dev": "node --env-file-if-exists=.env --import=tsx apps/api/src/backup-cli.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
